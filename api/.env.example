# Copy to .env and edit for local development.
APP_ENV=dev
LOG_LEVEL=INFO

# Local Postgres (started via `make db.up`)
DATABASE_URL=postgresql+psycopg://imamhadi:imamhadi_dev_password@localhost:5433/imamhadi

UPLOAD_DIR=./uploads
