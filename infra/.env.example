# Copy this file to .env (in the same directory) on the production host and
# fill in every value.  .env is gitignored.  All values are also accepted as
# real environment variables — Compose merges both.

# GitHub Container Registry image source.  Lowercased — ghcr requires it.
GH_OWNER=mhmb
GH_REPO=imam-hadi-network

# Image tag to deploy.  Use 'latest' (built on every push to main) for the
# always-current main, or a vX.Y.Z tag for a pinned release, or sha-xxxxxx
# for a specific commit.
IMAGE_TAG=latest

# Public hostname Traefik issues a Let's Encrypt certificate for.  Must
# resolve to this host's public IP.  The OVH default subdomain works out of
# the box; replace with a custom domain when DNS is ready.
PUBLIC_HOST=vps-d5fdd1dd.vps.ovh.us
ACME_EMAIL=admin@example.com

# Postgres password.  Also placed at /opt/imamhadi/secrets/db_password
# (chmod 600) for the docker secret mount.
DB_PASSWORD=change_me_to_a_long_random_string

# Basic-auth users.  Generate per-admin with:
#   docker run --rm httpd:alpine htpasswd -nbB admin '<password>'
# Multiple admins: comma-separated (Traefik label expansion).  In .env, $
# must be doubled to $$ so Compose doesn't try to expand them.
BASIC_AUTH_USERS=admin:$$2y$$05$$replace_with_real_bcrypt_hash

# Read-only token used by `docker login ghcr.io -u $GH_OWNER -p $GHCR_TOKEN`
# during the bootstrap.  Not consumed by Compose itself, but kept here so
# the deploy script can source one file.
GHCR_TOKEN=ghp_replace_with_personal_access_token_with_packages_read
